      "parameters": {
        "html": "<!DOCTYPE html>\n<html lang=\"pt-BR\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Dashboard de Tráfego Pago - Sistema Dinâmico</title>\n    <style>\n        /* CSS completo e funcional */\n        * { margin: 0; padding: 0; box-sizing: border-box; }\n        body { font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); min-height: 100vh; color: #333; }\n        .dashboard { padding: 20px; max-width: 1400px; margin: 0 auto; }\n        .header { background: rgba(255, 255, 255, 0.95); backdrop-filter: blur(10px); border-radius: 20px; padding: 20px 30px; margin-bottom: 30px; box-shadow: 0 8px 32px rgba(0, 0, 0, 0.1); display: flex; justify-content: space-between; align-items: center; animation: slideDown 0.6s ease-out; }\n        .header h1 { color: #2c3e50; font-size: 2.5rem; font-weight: 700; background: linear-gradient(45deg, #667eea, #764ba2); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; }\n        .date-time { text-align: right; color: #666; }\n        .campaign-info { background: rgba(255, 255, 255, 0.95); backdrop-filter: blur(10px); border-radius: 15px; padding: 20px; margin-bottom: 30px; box-shadow: 0 8px 32px rgba(0, 0, 0, 0.1); display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 20px; animation: fadeInUp 0.6s ease-out; }\n        .campaign-detail { display: flex; flex-direction: column; gap: 8px; }\n        .campaign-detail label { font-weight: 600; color: #2c3e50; }\n        .campaign-detail .value { padding: 12px 15px; background: linear-gradient(45deg, #667eea, #764ba2); color: white; border-radius: 10px; font-weight: 600; text-align: center; }\n        .stats-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 20px; margin-bottom: 30px; }\n        .stat-card { background: rgba(255, 255, 255, 0.95); backdrop-filter: blur(10px); border-radius: 20px; padding: 30px; box-shadow: 0 8px 32px rgba(0, 0, 0, 0.1); transition: all 0.3s ease; position: relative; overflow: hidden; animation: fadeInUp 0.6s ease-out forwards; opacity: 0; }\n        .stat-card:nth-child(1) { animation-delay: 0.1s; } .stat-card:nth-child(2) { animation-delay: 0.2s; } .stat-card:nth-child(3) { animation-delay: 0.3s; } .stat-card:nth-child(4) { animation-delay: 0.4s; } .stat-card:nth-child(5) { animation-delay: 0.5s; } .stat-card:nth-child(6) { animation-delay: 0.6s; } .stat-card:nth-child(7) { animation-delay: 0.7s; } .stat-card:nth-child(8) { animation-delay: 0.8s; }\n        .stat-card::before { content: ''; position: absolute; top: 0; left: 0; right: 0; height: 4px; }\n        .stat-card:hover { transform: translateY(-5px); box-shadow: 0 12px 40px rgba(0, 0, 0, 0.15); }\n        .impressions::before { background: linear-gradient(45deg, #667eea, #764ba2); } .clicks::before { background: linear-gradient(45deg, #f093fb, #f5576c); } .reach::before { background: linear-gradient(45deg, #4facfe, #00f2fe); } .spend::before { background: linear-gradient(45deg, #43e97b, #38f9d7); } .ctr::before { background: linear-gradient(45deg, #fa709a, #fee140); } .cpc::before { background: linear-gradient(45deg, #a8edea, #fed6e3); } .frequency::before { background: linear-gradient(45deg, #ff9a9e, #fecfef); } .roas::before { background: linear-gradient(45deg, #ffecd2, #fcb69f); }\n        .stat-icon { width: 60px; height: 60px; border-radius: 15px; display: flex; align-items: center; justify-content: center; font-size: 24px; margin-bottom: 15px; color: white; }\n        .stat-value { font-size: 2.5rem; font-weight: 700; color: #2c3e50; margin-bottom: 5px; }\n        .stat-label { color: #666; font-size: 1rem; }\n        @keyframes slideDown { from { opacity: 0; transform: translateY(-30px); } to { opacity: 1; transform: translateY(0); } }\n        @keyframes fadeInUp { from { opacity: 0; transform: translateY(30px); } to { opacity: 1; transform: translateY(0); } }\n        @media (max-width: 768px) { \n            .dashboard { padding: 15px; }\n            .header { flex-direction: column; text-align: center; gap: 15px; padding: 15px 20px; }\n            .header h1 { font-size: 1.8rem; }\n            .campaign-info { grid-template-columns: 1fr; padding: 15px; }\n            .stats-grid { grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 15px; }\n            .stat-card { padding: 20px; }\n            .stat-icon { width: 50px; height: 50px; font-size: 20px; }\n            .stat-value { font-size: 2rem; }\n        }\n        @media (max-width: 480px) {\n            .dashboard { padding: 10px; }\n            .header h1 { font-size: 1.5rem; }\n            .stats-grid { grid-template-columns: 1fr; gap: 10px; }\n            .stat-card { padding: 15px; }\n            .stat-icon { width: 45px; height: 45px; font-size: 18px; }\n            .stat-value { font-size: 1.6rem; }\n            .stat-label { font-size: 0.9rem; }\n        }\n    </style>\n</head>\n<body>\n    <div class=\"dashboard\">\n        <div class=\"header\"><h1>Dashboard de Tráfego Pago</h1><div class=\"date-time\"><div id=\"current-date\"></div><div id=\"current-time\"></div></div></div>\n        \n        <div class=\"campaign-info\">\n            <div class=\"campaign-detail\">\n                <label>Nome da Campanha:</label>\n                <div class=\"value\" id=\"campaign-name\">-</div>\n            </div>\n            <div class=\"campaign-detail\">\n                <label>Período Inicial:</label>\n                <div class=\"value\" id=\"campaign-start\">-</div>\n            </div>\n            <div class=\"campaign-detail\">\n                <label>Período Final:</label>\n                <div class=\"value\" id=\"campaign-end\">-</div>\n            </div>\n            <div class=\"campaign-detail\">\n                <label>Duração:</label>\n                <div class=\"value\" id=\"campaign-duration\">-</div>\n            </div>\n            <div class=\"campaign-detail\">\n                <label>Status:</label>\n                <div class=\"value\" id=\"campaign-status\">-</div>\n            </div>\n        </div>\n\n        <div class=\"stats-grid\">\n            <div class=\"stat-card impressions\"><div class=\"stat-icon\" style=\"background: linear-gradient(45deg, #667eea, #764ba2);\">👁️</div><div class=\"stat-value\" id=\"impressions\">0</div><div class=\"stat-label\">Impressões</div></div>\n            <div class=\"stat-card clicks\"><div class=\"stat-icon\" style=\"background: linear-gradient(45deg, #f093fb, #f5576c);\">👆</div><div class=\"stat-value\" id=\"clicks\">0</div><div class=\"stat-label\">Cliques</div></div>\n            <div class=\"stat-card reach\"><div class=\"stat-icon\" style=\"background: linear-gradient(45deg, #4facfe, #00f2fe);\">🎯</div><div class=\"stat-value\" id=\"reach\">0</div><div class=\"stat-label\">Alcance</div></div>\n            <div class=\"stat-card spend\"><div class=\"stat-icon\" style=\"background: linear-gradient(45deg, #43e97b, #38f9d7);\">💰</div><div class=\"stat-value\" id=\"spend\">R$ 0,00</div><div class=\"stat-label\">Gasto Total</div></div>\n            <div class=\"stat-card ctr\"><div class=\"stat-icon\" style=\"background: linear-gradient(45deg, #fa709a, #fee140);\">📊</div><div class=\"stat-value\" id=\"ctr\">0%</div><div class=\"stat-label\">CTR (Taxa de Cliques)</div></div>\n            <div class=\"stat-card cpc\"><div class=\"stat-icon\" style=\"background: linear-gradient(45deg, #a8edea, #fed6e3);\">💎</div><div class=\"stat-value\" id=\"cpc\">R$ 0,00</div><div class=\"stat-label\">CPC (Custo por Clique)</div></div>\n            <div class=\"stat-card frequency\"><div class=\"stat-icon\" style=\"background: linear-gradient(45deg, #ff9a9e, #fecfef);\">🔄</div><div class=\"stat-value\" id=\"frequency\">0</div><div class=\"stat-label\">Frequência</div></div>\n            <div class=\"stat-card roas\"><div class=\"stat-icon\" style=\"background: linear-gradient(45deg, #ffecd2, #fcb69f);\">📈</div><div class=\"stat-value\" id=\"invest_daily\">R$ 0,00</div><div class=\"stat-label\">Investimento Diário</div></div>\n        </div>\n    </div>\n\n    <script>\n        class N8NDashboard {\n            constructor() {\n                this.data = {\n                    campaign_name: \"{{ $json.campaign_name }}\",\n                    date_start: \"{{ $json.date_start }}\",\n                    date_stop: \"{{ $json.date_stop }}\",\n                    impressions: parseInt(\"{{ $json.impressions }}\") || 0,\n                    clicks: parseInt(\"{{ $json.clicks }}\") || 0,\n                    spend: parseFloat(\"{{ $json.spend }}\") || 0,\n                    reach: parseInt(\"{{ $json.reach }}\") || 0,\n                    ctr: parseFloat(\"{{ $json.ctr }}\") || 0,\n                    cpc: parseFloat(\"{{ $json.cpc }}\") || 0,\n                    frequency: parseFloat(\"{{ $json.frequency }}\") || 0,\n                    invest_daily: parseFloat(\"{{ $json.invest_daily }}\") || 0\n                };\n                this.init();\n            }\n\n            init() {\n                this.updateCampaignInfo();\n                this.updateStats();\n                this.updateDateTime();\n                setInterval(() => this.updateDateTime(), 1000);\n            }\n\n            formatCurrency(value) {\n                return value.toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' });\n            }\n\n            formatNumber(value) {\n                return value.toLocaleString('pt-BR');\n            }\n            \n            updateCampaignInfo() {\n                document.getElementById('campaign-name').textContent = this.data.campaign_name;\n                \n                try {\n                    // Atualiza datas e status\n                    const startDateObj = new Date(this.data.date_start);\n                    const endDateObj = new Date(this.data.date_stop);\n                    document.getElementById('campaign-start').textContent = startDateObj.toLocaleDateString('pt-BR', { timeZone: 'UTC' });\n                    document.getElementById('campaign-end').textContent = endDateObj.toLocaleDateString('pt-BR', { timeZone: 'UTC' });\n                    const now = new Date();\n                    document.getElementById('campaign-status').textContent = now <= endDateObj ? 'Ativa' : 'Finalizada';\n\n                    // Calcula e atualiza a duração da campanha\n                    const startDateString = this.data.date_start.split('T')[0];\n                    const endDateString = this.data.date_stop.split('T')[0];\n                    const startParts = startDateString.split('-').map(Number);\n                    const endParts = endDateString.split('-').map(Number);\n                    const startDateUTC = Date.UTC(startParts[0], startParts[1] - 1, startParts[2]);\n                    const endDateUTC = Date.UTC(endParts[0], endParts[1] - 1, endParts[2]);\n                    const diffTime = endDateUTC - startDateUTC;\n                    \n                    // >>> AQUI ESTÁ A CORREÇÃO <<<\n                    // Calcula a diferença exata de dias corridos entre as datas.\n                    const diffDays = Math.round(diffTime / (1000 * 60 * 60 * 24));\n\n                    if (diffDays >= 0) {\n                        document.getElementById('campaign-duration').textContent = `${diffDays} dias`;\n                    } else {\n                        document.getElementById('campaign-duration').textContent = 'Inválido';\n                    }\n\n                } catch (e) {\n                    document.getElementById('campaign-start').textContent = 'Data inválida';\n                    document.getElementById('campaign-end').textContent = 'Data inválida';\n                    document.getElementById('campaign-duration').textContent = 'Erro';\n                }\n            }\n\n            updateStats() {\n                document.getElementById('impressions').textContent = this.formatNumber(this.data.impressions);\n                document.getElementById('clicks').textContent = this.formatNumber(this.data.clicks);\n                document.getElementById('reach').textContent = this.formatNumber(this.data.reach);\n                document.getElementById('spend').textContent = this.formatCurrency(this.data.spend);\n                document.getElementById('ctr').textContent = `${this.data.ctr.toFixed(2)}%`;\n                document.getElementById('cpc').textContent = this.formatCurrency(this.data.cpc);\n                document.getElementById('frequency').textContent = this.data.frequency.toFixed(2);\n                document.getElementById('invest_daily').textContent = this.formatCurrency(this.data.invest_daily);\n            }\n            \n            updateDateTime() {\n                const now = new Date();\n                const dateOptions = { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric', timeZone: 'America/Sao_Paulo' };\n                const timeOptions = { hour: '2-digit', minute: '2-digit', second: '2-digit', timeZone: 'America/Sao_Paulo' };\n                document.getElementById('current-date').textContent = now.toLocaleDateString('pt-BR', dateOptions);\n                document.getElementById('current-time').textContent = now.toLocaleTimeString('pt-BR', timeOptions);\n            }\n        }\n\n        document.addEventListener('DOMContentLoaded', () => {\n            new N8NDashboard();\n        });\n    </script>\n</body>\n</html>"
