      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1152,
        240
      ],
      "id": "0f47eba6-a387-49d0-8c30-1efd4d2342b9",
      "name": "Kokoro"
    },
    {
      "parameters": {
        "jsCode": "// --- INPUTS ---\n// Entradas para o vídeo principal e narração\nconst audioDuration = $('GetAudioDuration').first().json.audioDuration;\nconst audioUrl = $('DriveAudio').first().json.webContentLink;\nconst videoUrl = $('SET').first().json[\"VIDEO DOWNLOAD\"];\n\n// Duração do vídeo base que será repetido.\n// É importante ter esse valor. Se não vier de outro nó, defina um valor aproximado.\nconst videoBaseDuration = 12; // Duração em segundos do seu arquivo de vídeo\n\n// --- LÓGICA DE LOOP ROBUSTA PARA O VÍDEO ---\nconst videoClips = [];\nlet videoTempoAcumulado = 0;\n\n// Calcula o número de repetições necessárias, arredondando para cima\nconst numeroDeLoops = Math.ceil(audioDuration / videoBaseDuration);\n\nfor (let i = 0; i < numeroDeLoops; i++) {\n  // Calcula quanto tempo ainda falta preencher no vídeo final\n  const tempoRestante = audioDuration - videoTempoAcumulado;\n\n  // Garante que não adicionamos clipes desnecessários se o tempo já foi preenchido\n  if (tempoRestante > 0) {\n    const clipe = {\n      asset: {\n        type: \"video\",\n        src: videoUrl,\n        volume: 0\n      },\n      start: videoTempoAcumulado,\n      // O clipe terá a duração do vídeo base ou o tempo que falta, o que for menor\n      length: Math.min(videoBaseDuration, tempoRestante),\n      fit: \"cover\"\n    };\n    videoClips.push(clipe);\n    // Incrementa o tempo acumulado para o próximo clipe\n    videoTempoAcumulado += videoBaseDuration;\n  }\n}\n\n// --- CONSTRUÇÃO DA TIMELINE FINAL ---\nconst timeline = {\n  tracks: [\n    // Trilha 1: Vídeo de fundo em loop\n    {\n      clips: videoClips // Array de clipes de vídeo que criamos\n    },\n    // Trilha 2: Áudio Principal/Narração\n    {\n      clips: [\n        {\n          asset: {\n            type: \"audio\",\n            src: audioUrl\n          },\n          start: 0,\n          length: audioDuration\n        }\n      ]\n    }\n  ]\n};\n\n// --- OUTPUT ---\nconst output = {\n  format: 'mp4',\n  resolution: 'hd',\n  fps: 30,\n  aspectRatio: '9:16'\n};\n\nreturn [\n  {\n    json: {\n      timeline,\n      output\n    }\n  }\n];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -208,
        704
      ],
      "id": "cb03faef-74f6-48ce-ad99-42b670adf6ab",
      "name": "CriarClipes",
