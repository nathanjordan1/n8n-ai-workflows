    {
      "parameters": {
        "jsCode": "// GetAudioDuration (Code node) - Kokoro Local\n// Usamos a mesma lógica de contagem de palavras usada para gerar as legendas\n\nconst text = $items('Kokoro')[0].json.ROTEIRO; // texto enviado para Kokoro\nif (!text) {\n  throw new Error('ROTEIRO não encontrado no output do Kokoro');\n}\n\nconst words = text.split(/\\s+/);\n\n// Estimativa: 0.4s por palavra (~150 palavras/min)\nconst audioDuration = words.length * 0.4;\n\n// Retorna a duração total do áudio (estimada)\nreturn [{\n  json: {\n    audioDuration,\n  },\n}];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -304,
        368
      ],
      "id": "685d7b19-07b7-40f1-b3d8-c4760140f166",
      "name": "GetAudioDuration"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "{{ $env.URL }}",
        "authentication": "{{ $env.AUTHENTICATION }}",
        "genericAuthType": "{{ $env.GENERICAUTHTYPE }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"timeline\": {{ JSON.stringify($('CriarClipes').first().json.timeline) }},\n  \"output\": {{ JSON.stringify($('CriarClipes').first().json.output) }}\n}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -64,
        368
      ],
      "id": "8a108ec6-e25e-430f-b375-30c09a25ec9b",
      "name": "Editor",
