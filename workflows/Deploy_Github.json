      "parameters": {
        "jsCode": "const raw = $('Extract from File').item.json.data;\n\n// 1️⃣ Garante objeto\nconst parsed = typeof raw === 'string'\n  ? JSON.parse(raw)\n  : raw;\n\n// 2️⃣ NORMALIZA para schema da API\nconst workflowObject = {\n  name: parsed.name ?? $json.name,\n  nodes: parsed.nodes,\n  connections: parsed.connections,\n  settings: parsed.settings ?? {},\n  active: false\n};\n\n// 3️⃣ VALIDAÇÃO DURA\nif (!Array.isArray(workflowObject.nodes)) {\n  throw new Error('Workflow inválido: nodes não é array');\n}\n\nif (typeof workflowObject.connections !== 'object') {\n  throw new Error('Workflow inválido: connections não é objeto');\n}\n\nreturn [{\n  json: {\n    ...$json,\n    workflowParsed: workflowObject\n  }\n}];\n"
